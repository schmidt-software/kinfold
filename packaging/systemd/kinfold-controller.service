# Kinfold controller and relay.
#
# Install:
#   useradd --system --home-dir /var/lib/kinfold-controller --shell /usr/sbin/nologin kinfold
#   install -m 0755 kinfold /usr/local/bin/kinfold
#   install -m 0644 kinfold-controller.service /etc/systemd/system/
#   systemctl daemon-reload
#   sudo -u kinfold kinfold init -data /var/lib/kinfold-controller/state -server vpn.example.com:8443
#   systemctl enable --now kinfold-controller
#
# Administrative commands must run as the same user, e.g.
#   sudo -u kinfold kinfold allow -data /var/lib/kinfold-controller/state -from alice -to bob

[Unit]
Description=Kinfold controller and relay
Documentation=https://github.com/schmidt-software/kinfold
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kinfold
Group=kinfold
ExecStart=/usr/local/bin/kinfold serve -data /var/lib/kinfold-controller/state -listen :8443
Restart=on-failure
RestartSec=2s
# Room for the 1,152 connection slots plus state files.
LimitNOFILE=4096

StateDirectory=kinfold-controller
StateDirectoryMode=0700
UMask=0077

# The controller needs no capabilities: it listens on an unprivileged port
# and only reads and writes its own state directory.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Fail blocked system calls with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
